rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwnerOrAdmin() {
      return getUserRole() in ['owner', 'admin'];
    }

    function isValidSize() {
      return request.resource.size <= 10 * 1024 * 1024; // Max 10MB
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidDocType() {
      return request.resource.contentType in [
        'application/pdf',
        'image/jpeg', 'image/png', 'image/webp',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      ];
    }

    // Product Images
    match /products/{productId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize() && isValidImageType();
    }

    // Purchase Invoices & Bills
    match /purchases/{purchaseId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize() && isValidDocType();
    }

    // Electricity Bills
    match /electricity/{billId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize() && isValidDocType();
    }

    // Rent Receipts
    match /rent/{rentId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize() && isValidDocType();
    }

    // Employee Documents
    match /employees/{employeeId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize() && isValidDocType();
    }

    // Salary Documents
    match /salaries/{salaryId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize() && isValidDocType();
    }

    // General Documents
    match /documents/{docId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize() && isValidDocType();
      allow delete: if isOwnerOrAdmin();
    }

    // Shop Logo
    match /settings/logo/{fileName} {
      allow read: if true; // Public logo
      allow write: if isOwnerOrAdmin() && isValidSize() && isValidImageType();
    }
  }
}
